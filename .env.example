# Copy to .env and fill in your values. Never commit .env.

AWS_REGION=us-east-1
S3_BUCKET=your-unique-olist-analytics-bucket

# Optional: named profile from ~/.aws/credentials (leave blank to use default chain)
AWS_PROFILE=

# Local paths (relative to project root)
DATA_DIR=data
LOCAL_RAW_DIR=lake/raw/olist
LOCAL_PROCESSED_DIR=lake/processed/star

# S3 key prefixes
S3_RAW_PREFIX=raw/olist
S3_PROCESSED_PREFIX=processed/star
